# Contexure Backend Environment Configuration
ENVIRONMENT=production
SERVICE_NAME=contexure-backend
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app"]

# LLM Providers (Free Tier APIs)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-cloud-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Cloud (1GB Free Tier Cluster)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=industrial_datasheets

# RAG & Guardrail Parameters
CONFIDENCE_THRESHOLD=0.65
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
