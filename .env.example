# Contexure Environment Variables Template

# Frontend Settings
NEXT_PUBLIC_APP_NAME="Contexure"
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Admin Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"
ADMIN_GITHUB_USERNAMES="HOSEKI7"

# Backend Settings (FastAPI)
ENVIRONMENT="development"
SERVICE_NAME="contexure-backend"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","https://*.vercel.app"]'

# LLM Providers
GEMINI_API_KEY="your-google-ai-studio-api-key"
GROQ_API_KEY="your-groq-cloud-api-key"

# Vector Database (Qdrant Cloud)
QDRANT_URL="https://your-cluster-id.region.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-cloud-api-key"
QDRANT_COLLECTION="industrial_datasheets"

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="contexure-datasheets"
R2_PUBLIC_URL="https://your-custom-or-r2-public-domain.com"
